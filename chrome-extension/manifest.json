{
  "manifest_version": 3,
  "name": "Share URL",
  "version": "1.0.0",
  "description": "Send the current page or a link to your Share URL download server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Share URL",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
